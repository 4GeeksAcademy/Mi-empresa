# TrackFlow API - Variables de entorno
# Copia este archivo como .env y rellena los valores

# Clave secreta para firmar tokens JWT
SECRET_KEY=tu-clave-secreta

# Duración de los tokens de acceso en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key de Resend para envío de emails transaccionales
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Dirección del frontend para construir enlaces de restablecimiento
FRONTEND_URL=http://localhost:3000

# Dirección del remitente para emails (usar onboarding@resend.dev en desarrollo)
EMAIL_FROM=onboarding@resend.dev
